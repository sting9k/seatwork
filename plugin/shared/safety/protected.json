{
  "$comment": "Files whose writing gives a foothold. Paths under home are relative to it; names compare without case.",
  "homeDirs": [".ssh", ".gnupg", ".bashrc.d", ".zshrc.d", ".password-store", ".config/gcloud/legacy_credentials"],
  "homeFiles": [
    ".aws/credentials",
    ".aws/config",
    ".netrc",
    "_netrc",
    ".git-credentials",
    ".npmrc",
    ".pypirc",
    ".docker/config.json",
    ".kube/config",
    ".config/gh/hosts.yml",
    ".config/hub",
    ".pgpass",
    ".my.cnf",
    ".cargo/credentials.toml",
    ".cargo/credentials",
    ".gem/credentials",
    ".vault-token",
    ".terraform.d/credentials.tfrc.json",
    ".config/gcloud/application_default_credentials.json",
    ".config/gcloud/credentials.db",
    ".config/gcloud/access_tokens.db",
    ".azure/accessTokens.json",
    ".azure/msal_token_cache.json",
    ".boto",
    ".s3cfg",
    ".bashrc",
    ".bash_profile",
    ".bash_login",
    ".profile",
    ".zshrc",
    ".zshenv",
    ".zprofile",
    ".zlogin"
  ],
  "etcDirs": ["sudoers.d", "ssh"],
  "etcFiles": ["sudoers", "passwd", "shadow", "group", "gshadow"],
  "append": [".ssh/known_hosts", ".ssh/known_hosts2"],
  "free": [".ssh/*.pub"],
  "envRoots": {
    "GNUPGHOME": ".gnupg",
    "XDG_CONFIG_HOME": ".config",
    "GH_CONFIG_DIR": ".config/gh",
    "DOCKER_CONFIG": ".docker",
    "KUBECONFIG": ".kube/config",
    "AWS_SHARED_CREDENTIALS_FILE": ".aws/credentials",
    "AWS_CONFIG_FILE": ".aws/config",
    "NPM_CONFIG_USERCONFIG": ".npmrc",
    "ZDOTDIR": ""
  },
  "anchors": [".ssh", ".gnupg", ".aws", ".kube", ".docker", ".bashrc.d", ".zshrc.d", ".git"],
  "anchorFiles": [".bashrc", ".bash_profile", ".bash_login", ".profile", ".zshrc", ".zshenv", ".zprofile", ".zlogin"],
  "roomHomeFiles": [".gitconfig", ".config/git/config"]
}

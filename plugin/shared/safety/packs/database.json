{
  "$comment": "Off until turned on. sql: read on the statements a client gets; statement: must open one; noWhere: UPDATE without WHERE.",
  "clients": {
    "database.postgresql": ["psql"],
    "database.mysql": ["mysql", "mariadb"],
    "database.mongodb": ["mongosh", "mongo"],
    "database.redis": ["redis-cli", "valkey-cli", "keydb-cli"],
    "database.sqlite": ["sqlite3"]
  },
  "packs": [
    {
      "id": "database.postgresql",
      "tier": 7,
      "rules": {
        "stdin-unverified": {
          "severity": "high",
          "reason": "psql reads statements the room cannot see",
          "explanation": "Input from a file or a pipe is not shown to the room, so it may hold a DROP or a DELETE.",
          "safer": ["Pass the statements with -c so they can be read"]
        },
        "drop-database": {
          "severity": "critical",
          "sql": "\\bDROP\\s+DATABASE\\b",
          "reason": "DROP DATABASE",
          "explanation": "The database and all its data go.",
          "safer": ["pg_dump it first"]
        },
        "drop-table": {
          "severity": "high",
          "sql": "\\bDROP\\s+TABLE\\b",
          "reason": "DROP TABLE",
          "explanation": "The table and its rows go.",
          "safer": ["pg_dump -t <table> first"]
        },
        "drop-schema": {
          "severity": "critical",
          "sql": "\\bDROP\\s+SCHEMA\\b",
          "reason": "DROP SCHEMA",
          "explanation": "Every table in the schema goes.",
          "safer": ["pg_dump -n <schema> first"]
        },
        "truncate-table": {
          "severity": "high",
          "sql": "TRUNCATE\\s+(TABLE\\s+)?(ONLY\\s+)?[A-Za-z_\"][\\w.\"]*",
          "statement": true,
          "reason": "TRUNCATE",
          "explanation": "Every row of the table goes.",
          "safer": ["SELECT count(*) first", "Back the table up"]
        },
        "delete-without-where": {
          "severity": "high",
          "sql": "DELETE\\s+FROM\\s+[\\w.\"]+\\s*(;|$)",
          "statement": true,
          "reason": "DELETE with no WHERE",
          "explanation": "Every row of the table goes.",
          "safer": ["Add a WHERE clause", "Run the SELECT with the same WHERE first"]
        },
        "update-without-where": {
          "severity": "high",
          "noWhere": true,
          "reason": "UPDATE with no WHERE",
          "explanation": "Every row of the table changes.",
          "safer": ["Add a WHERE clause"]
        },
        "drop-column": {
          "severity": "high",
          "sql": "ALTER\\s+TABLE[\\s\\S]*?\\bDROP\\s+(COLUMN\\s+)?(?!(DEFAULT|NOT\\s+NULL|CONSTRAINT|IDENTITY|INDEX|PRIMARY|FOREIGN|EXPRESSION)\\b)[\\w\"]",
          "reason": "ALTER TABLE ... DROP COLUMN",
          "explanation": "The column's data goes.",
          "safer": []
        },
        "dropdb-cli": {
          "severity": "critical",
          "reason": "dropdb",
          "explanation": "The database and all its data go.",
          "safer": ["pg_dump it first"],
          "match": [{ "commands": ["dropdb"] }]
        },
        "pg-dump-clean": {
          "severity": "high",
          "reason": "pg_dump --clean writes DROP statements into the dump",
          "explanation": "Restoring that dump drops the existing objects first.",
          "safer": ["pg_dump without --clean"],
          "match": [{ "commands": ["pg_dump"], "flags": ["--clean", "-c", "short:c"] }]
        }
      }
    },
    {
      "id": "database.mysql",
      "tier": 7,
      "rules": {
        "stdin-unverified": {
          "severity": "high",
          "reason": "mysql reads statements the room cannot see",
          "explanation": "Input from a file or a pipe is not shown to the room.",
          "safer": ["Pass the statements with -e"]
        },
        "drop-database": {
          "severity": "critical",
          "sql": "\\bDROP\\s+(DATABASE|SCHEMA)\\b",
          "reason": "DROP DATABASE",
          "explanation": "The database and all its data go.",
          "safer": ["mysqldump it first"]
        },
        "drop-table": {
          "severity": "high",
          "sql": "\\bDROP\\s+TABLE\\b",
          "reason": "DROP TABLE",
          "explanation": "The table and its rows go.",
          "safer": []
        },
        "truncate-table": {
          "severity": "high",
          "sql": "TRUNCATE\\s+(TABLE\\s+)?[A-Za-z_`][\\w.`]*",
          "statement": true,
          "reason": "TRUNCATE",
          "explanation": "Every row goes, and MySQL cannot roll it back.",
          "safer": []
        },
        "delete-without-where": {
          "severity": "high",
          "sql": "DELETE\\s+FROM\\s+[\\w.`]+\\s*(;|$)",
          "statement": true,
          "reason": "DELETE with no WHERE",
          "explanation": "Every row of the table goes.",
          "safer": ["Add a WHERE clause"]
        },
        "update-without-where": {
          "severity": "high",
          "noWhere": true,
          "reason": "UPDATE with no WHERE",
          "explanation": "Every row of the table changes.",
          "safer": ["Add a WHERE clause"]
        },
        "drop-column": {
          "severity": "high",
          "sql": "ALTER\\s+TABLE[\\s\\S]*?\\bDROP\\s+(COLUMN\\s+)?(?!(DEFAULT|INDEX|KEY|PRIMARY|FOREIGN|CONSTRAINT|CHECK)\\b)[\\w`]",
          "reason": "ALTER TABLE ... DROP COLUMN",
          "explanation": "The column's data goes.",
          "safer": []
        },
        "grant-all": {
          "severity": "high",
          "sql": "GRANT\\s+ALL\\b[\\s\\S]*\\bON\\s+\\*\\.\\*",
          "reason": "GRANT ALL ON *.*",
          "explanation": "The user gets every right on every database.",
          "safer": []
        },
        "drop-user": {
          "severity": "medium",
          "sql": "\\bDROP\\s+USER\\b",
          "reason": "DROP USER",
          "explanation": "The account can no longer log in.",
          "safer": []
        },
        "reset-master": {
          "severity": "critical",
          "sql": "\\bRESET\\s+(MASTER|BINARY\\s+LOGS)\\b",
          "reason": "RESET MASTER deletes the binary logs",
          "explanation": "Replication and point-in-time recovery lose their history.",
          "safer": []
        },
        "mysqladmin-drop": {
          "severity": "critical",
          "reason": "mysqladmin drop",
          "explanation": "The database goes.",
          "safer": [],
          "match": [{ "commands": ["mysqladmin"], "first": ["drop"] }]
        },
        "mysqldump-add-drop-database": {
          "severity": "high",
          "reason": "mysqldump --add-drop-database",
          "explanation": "Restoring the dump drops the database first.",
          "safer": [],
          "match": [{ "commands": ["mysqldump"], "flags": ["--add-drop-database"] }]
        },
        "mysqldump-add-drop-table": {
          "severity": "medium",
          "reason": "mysqldump --add-drop-table",
          "explanation": "Restoring the dump drops each table first.",
          "safer": [],
          "match": [{ "commands": ["mysqldump"], "flags": ["--add-drop-table"] }]
        }
      }
    },
    {
      "id": "database.mongodb",
      "tier": 7,
      "rules": {
        "stdin-unverified": {
          "severity": "high",
          "reason": "the mongo shell reads a script the room cannot see",
          "explanation": "Input from a file or a pipe is not shown to the room.",
          "safer": ["Pass the script with --eval"]
        },
        "drop-database": {
          "severity": "critical",
          "sql": "\\bdropDatabase\\s*\\(",
          "reason": "dropDatabase()",
          "explanation": "The database goes.",
          "safer": ["mongodump first"]
        },
        "drop-collection": {
          "severity": "high",
          "sql": "\\.(drop|dropCollection)\\s*\\(",
          "reason": "a collection drop",
          "explanation": "The collection and its documents go.",
          "safer": ["mongodump --collection first"]
        },
        "delete-all": {
          "severity": "high",
          "sql": "\\.(remove|deleteMany)\\s*\\(\\s*\\{\\s*\\}",
          "reason": "deleteMany({}) removes every document",
          "explanation": "An empty filter matches the whole collection.",
          "safer": ["Give the filter"]
        },
        "update-all": {
          "severity": "high",
          "sql": "\\.updateMany\\s*\\(\\s*\\{\\s*\\}",
          "reason": "updateMany({}) changes every document",
          "explanation": "An empty filter matches the whole collection.",
          "safer": ["Give the filter"]
        },
        "mongorestore-drop": {
          "severity": "high",
          "reason": "mongorestore --drop",
          "explanation": "Each collection is dropped before the restore.",
          "safer": [],
          "match": [{ "commands": ["mongorestore"], "flags": ["--drop"] }]
        }
      }
    },
    {
      "id": "database.redis",
      "tier": 7,
      "rules": {
        "stdin-unverified": {
          "severity": "high",
          "reason": "redis-cli reads commands the room cannot see",
          "explanation": "Input from a file or a pipe is not shown to the room.",
          "safer": ["Pass the command as arguments"]
        },
        "flushall": {
          "severity": "critical",
          "sql": "\\bFLUSHALL\\b",
          "reason": "FLUSHALL",
          "explanation": "Every key of every database goes.",
          "safer": []
        },
        "flushdb": {
          "severity": "high",
          "sql": "\\bFLUSHDB\\b",
          "reason": "FLUSHDB",
          "explanation": "Every key of the database goes.",
          "safer": []
        },
        "config-resetstat": {
          "severity": "medium",
          "sql": "\\bCONFIG\\s+RESETSTAT\\b",
          "reason": "CONFIG RESETSTAT",
          "explanation": "The server's counters are lost.",
          "safer": []
        },
        "debug-crash": {
          "severity": "critical",
          "sql": "\\bDEBUG\\s+(SEGFAULT|CRASH)\\b",
          "reason": "DEBUG SEGFAULT",
          "explanation": "The server crashes.",
          "safer": []
        },
        "debug-sleep": {
          "severity": "high",
          "sql": "\\bDEBUG\\s+SLEEP\\b",
          "reason": "DEBUG SLEEP",
          "explanation": "The server stops answering.",
          "safer": []
        },
        "shutdown": {
          "severity": "high",
          "sql": "\\bSHUTDOWN\\b",
          "reason": "SHUTDOWN",
          "explanation": "The server stops; with NOSAVE unsaved keys go.",
          "safer": []
        },
        "config-dangerous": {
          "severity": "critical",
          "sql": "\\bCONFIG\\s+SET\\s+(dir|dbfilename|slaveof|replicaof)\\b",
          "reason": "CONFIG SET of a file path or replication source",
          "explanation": "These settings are a known way to write files or hand the data to another server.",
          "safer": []
        },
        "config-set-maxmemory": {
          "severity": "critical",
          "sql": "\\bCONFIG\\s+SET\\s+maxmemory(-policy)?\\b",
          "reason": "CONFIG SET maxmemory",
          "explanation": "A lower limit can evict keys at once.",
          "safer": []
        },
        "config-set-persistence": {
          "severity": "high",
          "sql": "\\bCONFIG\\s+SET\\s+(save|appendonly)\\b",
          "reason": "CONFIG SET save or appendonly",
          "explanation": "Persistence can be turned off.",
          "safer": []
        },
        "config-rewrite": {
          "severity": "high",
          "sql": "\\bCONFIG\\s+REWRITE\\b",
          "reason": "CONFIG REWRITE",
          "explanation": "The running changes are written into the server's config file.",
          "safer": []
        },
        "mass-delete": {
          "severity": "high",
          "reason": "keys from KEYS or SCAN piped into DEL",
          "explanation": "The pattern may match far more keys than meant.",
          "safer": ["Count the keys first"]
        }
      }
    },
    {
      "id": "database.sqlite",
      "tier": 7,
      "rules": {
        "stdin-unverified": {
          "severity": "high",
          "reason": "sqlite3 reads statements the room cannot see",
          "explanation": "Input from a file or a pipe is not shown to the room.",
          "safer": ["Pass the statements as an argument"]
        },
        "drop-table": {
          "severity": "critical",
          "sql": "\\bDROP\\s+TABLE\\b",
          "reason": "DROP TABLE",
          "explanation": "The table and its rows go.",
          "safer": ["sqlite3 <db> .dump <table> first"]
        },
        "delete-without-where": {
          "severity": "critical",
          "sql": "DELETE\\s+FROM\\s+[\\w.\"]+\\s*(;|$)",
          "statement": true,
          "reason": "DELETE with no WHERE",
          "explanation": "Every row of the table goes.",
          "safer": ["Add a WHERE clause"]
        },
        "update-without-where": {
          "severity": "high",
          "noWhere": true,
          "reason": "UPDATE with no WHERE",
          "explanation": "Every row of the table changes.",
          "safer": ["Add a WHERE clause"]
        },
        "drop-column": {
          "severity": "high",
          "sql": "ALTER\\s+TABLE[\\s\\S]*?\\bDROP\\s+(COLUMN\\s+)?[\\w\"]",
          "reason": "ALTER TABLE ... DROP COLUMN",
          "explanation": "The column's data goes.",
          "safer": []
        },
        "vacuum-into": {
          "severity": "medium",
          "sql": "\\bVACUUM\\s+INTO\\b",
          "reason": "VACUUM INTO",
          "explanation": "It writes over the target file if it exists.",
          "safer": []
        }
      }
    }
  ]
}

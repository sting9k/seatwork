{
  "$comment": "The room's protocol words, each written once, in the order a seat is shown them. report: may open a final message. closesWork: the work is finished. counted: counted by name in stats. verdict: what it says of the work it answers. answers: answers an ask. asks: what a report with it asks above. priority, toWorker: urgency of a subject naming it, the second for mail down to a seat that owns none. receipt: from above and asking nothing, it wakes no seat whose work is in. onlyAfterCandidate: it returns work only in answer to a candidate. notices: the room's own subjects.",
  "signals": [
    { "name": "CANDIDATE", "report": true, "closesWork": true, "counted": true, "priority": "action" },
    { "name": "REVIEW", "report": true, "closesWork": true, "counted": true, "priority": "action" },
    { "name": "DONE", "report": true, "closesWork": true, "priority": "action" },
    { "name": "STATUS", "report": true },
    { "name": "QUESTION", "report": true, "counted": true, "priority": "action", "asks": "decision" },
    { "name": "REOPEN_REQUEST", "report": true, "counted": true, "priority": "action", "asks": "decision" },
    { "name": "DEPENDENCY_REQUEST", "report": true, "counted": true, "priority": "action", "asks": "decision" },
    { "name": "BLOCKED", "report": true, "counted": true, "priority": "blocking", "asks": "decision" },
    { "name": "DECISION_NEEDED", "report": true, "counted": true, "priority": "action", "asks": "decision" },
    { "name": "HANDOFF" },
    { "name": "ACK" },
    {
      "name": "REVISED BRIEF",
      "counted": true,
      "verdict": "returned",
      "answers": true,
      "toWorker": "blocking",
      "onlyAfterCandidate": true
    },
    { "name": "INSTRUCTION" },
    { "name": "STOP" },
    { "name": "ANSWER", "counted": true, "answers": true, "toWorker": "blocking" },
    { "name": "ACCEPT", "counted": true, "verdict": "accepted", "answers": true, "toWorker": "action" },
    { "name": "REJECT", "counted": true, "verdict": "returned", "answers": true, "toWorker": "blocking" },
    { "name": "HOLD", "counted": true, "toWorker": "blocking", "receipt": true },
    { "name": "NOTED", "receipt": true },
    { "name": "DEFER", "answers": true, "toWorker": "action", "verdict": "deferred" },
    { "name": "FYI" },
    { "name": "CHALLENGE" },
    { "name": "RESPONSE", "answers": true }
  ],
  "notices": [
    { "name": "FAILED", "priority": "blocking" },
    { "name": "PERMISSION", "priority": "blocking" },
    { "name": "GC" },
    { "name": "SPAWN REFUSED" },
    { "name": "RESUME" },
    { "name": "ROTATED" },
    { "name": "ROTATION FAILED" },
    { "name": "HAND-IN RETURNED" },
    { "name": "COUNCIL" }
  ]
}

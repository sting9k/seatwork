{
  "$comment": "Packs that are off until the room's policy or a project turns them on.",
  "packs": [
    {
      "id": "strict_git",
      "tier": 9,
      "rules": {
        "push-force-any": {
          "severity": "high",
          "reason": "any forced push, --force-with-lease included"
        },
        "push-mirror": {
          "severity": "high",
          "reason": "git push --mirror forces and deletes remote refs"
        },
        "push-delete": {
          "severity": "high",
          "reason": "git push --delete removes a remote ref"
        },
        "push-delete-refspec": {
          "severity": "high",
          "reason": "git push <remote> :<ref> removes a remote ref"
        },
        "push-prune": {
          "severity": "high",
          "reason": "git push --prune removes remote refs"
        },
        "push-dynamic-argument": {
          "severity": "high",
          "reason": "git push with an argument known only at run time"
        },
        "rebase": {
          "severity": "high",
          "reason": "git rebase rewrites commits"
        },
        "commit-amend": {
          "severity": "high",
          "reason": "git commit --amend rewrites the last commit"
        },
        "cherry-pick": {
          "severity": "high",
          "reason": "git cherry-pick needs a look first"
        },
        "filter-branch": {
          "severity": "high",
          "reason": "git filter-branch rewrites history"
        },
        "filter-repo": {
          "severity": "high",
          "reason": "git filter-repo rewrites history"
        },
        "reflog-expire": {
          "severity": "high",
          "reason": "git reflog expire"
        },
        "gc-aggressive": {
          "severity": "high",
          "reason": "git gc --aggressive or --prune"
        },
        "worktree-remove": {
          "severity": "high",
          "reason": "git worktree remove"
        },
        "submodule-deinit": {
          "severity": "high",
          "reason": "git submodule deinit"
        },
        "add-all-dot": {
          "severity": "high",
          "reason": "git add . stages everything"
        },
        "add-all-flag": {
          "severity": "high",
          "reason": "git add -A stages everything"
        },
        "push-master": {
          "severity": "high",
          "reason": "a push to master"
        },
        "push-main": {
          "severity": "high",
          "reason": "a push to main"
        }
      }
    },
    {
      "id": "package_managers",
      "tier": 8,
      "safe": [{ "commands": ["npm", "yarn", "pnpm", "cargo", "poetry"], "flags": ["--dry-run"] }],
      "rules": {
        "npm-publish": {
          "severity": "high",
          "reason": "npm publish releases a package",
          "match": [{ "commands": ["npm"], "first": ["publish"] }]
        },
        "yarn-publish": {
          "severity": "high",
          "reason": "yarn publish releases a package",
          "match": [{ "commands": ["yarn"], "seq": [["publish"]] }]
        },
        "pnpm-publish": {
          "severity": "high",
          "reason": "pnpm publish releases a package",
          "match": [{ "commands": ["pnpm"], "seq": [["publish"]] }]
        },
        "npm-unpublish": {
          "severity": "high",
          "reason": "npm unpublish removes a released version",
          "match": [{ "commands": ["npm"], "first": ["unpublish"] }]
        },
        "pip-uninstall": {
          "severity": "high",
          "reason": "pip uninstall",
          "match": [{ "commands": ["pip", "pip3"], "first": ["uninstall"] }]
        },
        "pip-url": {
          "severity": "high",
          "reason": "pip install from a URL",
          "match": [{ "commands": ["pip", "pip3"], "first": ["install"], "arg": "^(https?://|git\\+)" }]
        },
        "pip-system": {
          "severity": "high",
          "reason": "pip install into the system",
          "match": [
            { "commands": ["pip", "pip3"], "first": ["install"], "flags": ["--system"] },
            { "commands": ["pip", "pip3"], "first": ["install"], "arg": "^/usr" }
          ]
        },
        "apt-remove": {
          "severity": "high",
          "reason": "apt remove or purge",
          "match": [{ "commands": ["apt", "apt-get"], "first": ["remove", "purge", "autoremove"] }]
        },
        "yum-remove": {
          "severity": "high",
          "reason": "yum or dnf remove",
          "match": [{ "commands": ["yum", "dnf"], "first": ["remove", "erase", "autoremove"] }]
        },
        "cargo-publish": {
          "severity": "high",
          "reason": "cargo publish releases a crate",
          "match": [{ "commands": ["cargo"], "first": ["publish"] }]
        },
        "cargo-yank": {
          "severity": "high",
          "reason": "cargo yank",
          "match": [{ "commands": ["cargo"], "first": ["yank"] }]
        },
        "gem-push": {
          "severity": "high",
          "reason": "gem push releases a gem",
          "match": [{ "commands": ["gem"], "first": ["push"] }]
        },
        "gem-yank": {
          "severity": "high",
          "reason": "gem yank",
          "match": [{ "commands": ["gem"], "first": ["yank"] }]
        },
        "nuget-delete": {
          "severity": "high",
          "reason": "nuget delete",
          "match": [
            { "commands": ["nuget", "nuget.exe"], "first": ["delete"] },
            { "commands": ["dotnet"], "seq": [["nuget"], ["delete"]] }
          ]
        },
        "brew-uninstall": {
          "severity": "high",
          "reason": "brew uninstall",
          "match": [{ "commands": ["brew"], "first": ["uninstall", "remove", "rm"] }]
        },
        "poetry-publish": {
          "severity": "high",
          "reason": "poetry publish",
          "match": [{ "commands": ["poetry"], "first": ["publish"] }]
        },
        "poetry-remove": {
          "severity": "high",
          "reason": "poetry remove",
          "match": [{ "commands": ["poetry"], "first": ["remove"] }]
        },
        "maven-deploy": {
          "severity": "high",
          "reason": "mvn deploy",
          "match": [{ "commands": ["mvn", "mvnw"], "seq": [["deploy"]] }]
        },
        "maven-release-perform": {
          "severity": "high",
          "reason": "mvn release:perform",
          "match": [{ "commands": ["mvn", "mvnw"], "seq": [["release:perform"]] }]
        },
        "gradle-publish": {
          "severity": "high",
          "reason": "gradle publish",
          "match": [{ "commands": ["gradle", "gradlew"], "seq": [["publish"]] }]
        }
      }
    },
    {
      "id": "containers",
      "tier": 6,
      "rules": {
        "docker-system-prune": {
          "severity": "high",
          "reason": "docker system prune",
          "match": [{ "commands": ["docker", "podman"], "seq": [["system"], ["prune"]] }]
        },
        "podman-system-reset": {
          "severity": "critical",
          "reason": "podman system reset",
          "match": [{ "commands": ["podman"], "seq": [["system"], ["reset"]] }]
        },
        "volume-prune": {
          "severity": "high",
          "reason": "volume prune removes data volumes",
          "match": [{ "commands": ["docker", "podman"], "seq": [["volume"], ["prune"]] }]
        },
        "network-prune": {
          "severity": "high",
          "reason": "docker network prune",
          "match": [{ "commands": ["docker"], "seq": [["network"], ["prune"]] }]
        },
        "image-prune": {
          "severity": "medium",
          "reason": "image prune",
          "match": [{ "commands": ["docker", "podman"], "seq": [["image"], ["prune"]] }]
        },
        "container-prune": {
          "severity": "medium",
          "reason": "container prune",
          "match": [{ "commands": ["docker", "podman"], "seq": [["container"], ["prune"]] }]
        },
        "pod-prune": {
          "severity": "medium",
          "reason": "podman pod prune",
          "match": [{ "commands": ["podman"], "seq": [["pod"], ["prune"]] }]
        },
        "rm-force": {
          "severity": "high",
          "reason": "rm -f kills and removes a container",
          "match": [
            { "commands": ["docker", "podman"], "first": ["rm"], "flags": ["-f", "--force", "short:f"] },
            { "commands": ["docker", "podman"], "seq": [["container"], ["rm"]], "flags": ["-f", "--force", "short:f"] }
          ]
        },
        "rmi-force": {
          "severity": "high",
          "reason": "rmi -f removes images in use",
          "match": [{ "commands": ["docker", "podman"], "first": ["rmi"], "flags": ["-f", "--force", "short:f"] }]
        },
        "volume-rm": {
          "severity": "high",
          "reason": "volume rm deletes a data volume",
          "match": [{ "commands": ["docker", "podman"], "seq": [["volume"], ["rm", "remove"]] }]
        },
        "stop-all": {
          "severity": "high",
          "reason": "stop or kill of a list of containers from a substitution",
          "match": [{ "commands": ["docker", "podman"], "first": ["stop", "kill"], "dynamicArg": true }]
        },
        "compose-down-volumes": {
          "severity": "critical",
          "reason": "compose down -v deletes the project's volumes",
          "match": [
            {
              "commands": ["docker-compose", "podman-compose"],
              "first": ["down"],
              "flags": ["-v", "--volumes", "short:v"]
            },
            {
              "commands": ["docker", "podman"],
              "seq": [["compose"], ["down"]],
              "flags": ["-v", "--volumes", "short:v"]
            }
          ]
        },
        "compose-down-rmi": {
          "severity": "high",
          "reason": "compose down --rmi all",
          "match": [
            { "commands": ["docker-compose", "podman-compose"], "first": ["down"], "flags": ["--rmi"] },
            { "commands": ["docker", "podman"], "seq": [["compose"], ["down"]], "flags": ["--rmi"] }
          ]
        },
        "compose-rm-volumes": {
          "severity": "high",
          "reason": "compose rm -v",
          "match": [
            { "commands": ["docker-compose", "podman-compose"], "first": ["rm"], "flags": ["-v", "--volumes"] },
            { "commands": ["docker", "podman"], "seq": [["compose"], ["rm"]], "flags": ["-v", "--volumes"] }
          ]
        },
        "compose-rm-force": {
          "severity": "medium",
          "reason": "compose rm -f",
          "match": [
            { "commands": ["docker-compose", "podman-compose"], "first": ["rm"], "flags": ["-f", "--force"] },
            { "commands": ["docker", "podman"], "seq": [["compose"], ["rm"]], "flags": ["-f", "--force"] }
          ]
        }
      }
    },
    {
      "id": "secret_disclosure",
      "tier": 10,
      "rules": {
        "secret-read-output": {
          "severity": "high",
          "reason": "a secret manager prints secret values",
          "match": [
            { "commands": ["op"], "first": ["read"] },
            { "commands": ["op"], "seq": [["item", "document"], ["get"]] },
            { "commands": ["infisical"], "first": ["secrets", "export"], "noArg": "^(set|delete|folders)$" },
            { "commands": ["infisical"], "seq": [["dynamic-secrets"], ["lease"], ["create"]] },
            { "commands": ["doppler"], "seq": [["secrets"], ["get", "list", "download"]] },
            { "commands": ["doppler"], "first": ["secrets"], "noArg": "^(set|delete|upload|notes)$" },
            { "commands": ["vault"], "first": ["read"] },
            { "commands": ["vault"], "seq": [["kv"], ["get"]] },
            { "commands": ["aws"], "seq": [["secretsmanager"], ["get-secret-value", "batch-get-secret-value"]] },
            {
              "commands": ["aws"],
              "seq": [["ssm"], ["get-parameter", "get-parameters", "get-parameters-by-path", "get-parameter-history"]],
              "flags": ["--with-decryption"]
            }
          ]
        }
      },
      "safe": [{ "commands": ["op", "infisical", "doppler", "vault"], "flags": ["-h", "--help"] }]
    },
    {
      "id": "kubernetes",
      "tier": 5,
      "safe": [{ "commands": ["kubectl", "helm"], "flags": ["--dry-run", "--dry-run=client", "--dry-run=server"] }],
      "rules": {
        "kubectl-delete": {
          "severity": "high",
          "reason": "kubectl delete",
          "match": [{ "commands": ["kubectl", "oc"], "first": ["delete"] }]
        },
        "kubectl-delete-namespace": {
          "severity": "critical",
          "reason": "kubectl delete namespace",
          "match": [
            { "commands": ["kubectl", "oc"], "seq": [["delete"], ["namespace", "namespaces", "ns"]] },
            { "commands": ["kubectl", "oc"], "first": ["delete"], "flags": ["--all", "--all-namespaces", "-A"] }
          ]
        },
        "kubectl-drain": {
          "severity": "high",
          "reason": "kubectl drain or cordon",
          "match": [{ "commands": ["kubectl", "oc"], "first": ["drain", "cordon", "taint"] }]
        },
        "kubectl-scale-zero": {
          "severity": "high",
          "reason": "kubectl scale to zero",
          "match": [{ "commands": ["kubectl", "oc"], "first": ["scale"], "arg": "^--replicas=0$" }]
        },
        "kubectl-replace-force": {
          "severity": "high",
          "reason": "kubectl replace --force",
          "match": [{ "commands": ["kubectl", "oc"], "first": ["replace"], "flags": ["--force"] }]
        },
        "helm-uninstall": {
          "severity": "high",
          "reason": "helm uninstall",
          "match": [{ "commands": ["helm"], "first": ["uninstall", "delete", "del"] }]
        },
        "helm-rollback": {
          "severity": "medium",
          "reason": "helm rollback",
          "match": [{ "commands": ["helm"], "first": ["rollback"] }]
        }
      }
    },
    {
      "id": "infrastructure",
      "tier": 3,
      "rules": {
        "terraform-destroy": {
          "severity": "critical",
          "reason": "terraform destroy",
          "match": [
            { "commands": ["terraform", "tofu", "terragrunt"], "first": ["destroy"] },
            { "commands": ["terraform", "tofu", "terragrunt"], "first": ["apply"], "flags": ["-destroy", "--destroy"] }
          ]
        },
        "terraform-apply-auto": {
          "severity": "high",
          "reason": "terraform apply -auto-approve",
          "match": [
            {
              "commands": ["terraform", "tofu", "terragrunt"],
              "first": ["apply"],
              "flags": ["-auto-approve", "--auto-approve"]
            }
          ]
        },
        "terraform-state-rm": {
          "severity": "high",
          "reason": "terraform state rm or force-unlock",
          "match": [
            { "commands": ["terraform", "tofu"], "seq": [["state"], ["rm", "push", "replace-provider"]] },
            { "commands": ["terraform", "tofu"], "first": ["force-unlock"] }
          ]
        },
        "pulumi-destroy": {
          "severity": "critical",
          "reason": "pulumi destroy",
          "match": [
            { "commands": ["pulumi"], "first": ["destroy", "down"] },
            { "commands": ["pulumi"], "seq": [["stack"], ["rm"]] }
          ]
        },
        "pulumi-up-yes": {
          "severity": "high",
          "reason": "pulumi up --yes",
          "match": [{ "commands": ["pulumi"], "first": ["up", "update"], "flags": ["--yes", "-y", "--skip-preview"] }]
        },
        "cdk-destroy": {
          "severity": "critical",
          "reason": "cdk destroy",
          "match": [{ "commands": ["cdk"], "first": ["destroy"] }]
        }
      }
    },
    {
      "id": "cloud",
      "tier": 4,
      "rules": {
        "aws-delete": {
          "severity": "high",
          "reason": "an AWS call that deletes or terminates",
          "match": [
            { "commands": ["aws"], "arg": "^(delete-|terminate-|deregister-|remove-|purge-|rb$|batch-delete)" },
            { "commands": ["aws"], "seq": [["s3"], ["rm"]], "flags": ["--recursive"] }
          ]
        },
        "aws-s3-rb-force": {
          "severity": "critical",
          "reason": "aws s3 rb --force deletes a bucket and its objects",
          "match": [{ "commands": ["aws"], "seq": [["s3"], ["rb"]], "flags": ["--force"] }]
        },
        "gcloud-delete": {
          "severity": "high",
          "reason": "a gcloud call that deletes",
          "match": [
            { "commands": ["gcloud"], "arg": "^(delete|reset)$" },
            { "commands": ["gsutil"], "first": ["rm", "rb"] }
          ]
        },
        "gcloud-project-delete": {
          "severity": "critical",
          "reason": "gcloud projects delete",
          "match": [{ "commands": ["gcloud"], "seq": [["projects"], ["delete"]] }]
        },
        "az-delete": {
          "severity": "high",
          "reason": "an az call that deletes",
          "match": [{ "commands": ["az"], "arg": "^(delete|purge)$" }]
        },
        "az-group-delete": {
          "severity": "critical",
          "reason": "az group delete",
          "match": [{ "commands": ["az"], "seq": [["group"], ["delete"]] }]
        }
      }
    },
    {
      "id": "remote",
      "tier": 1,
      "rules": {
        "rsync-delete": {
          "severity": "high",
          "reason": "rsync --delete removes files at the destination",
          "match": [{ "commands": ["rsync"], "arg": "^--del", "noFlags": ["--dry-run", "-n", "short:n"] }]
        },
        "scp-overwrite-remote": {
          "severity": "medium",
          "reason": "scp onto a remote host",
          "match": [{ "commands": ["scp"], "last": "^[^/]*:" }]
        }
      }
    },
    {
      "id": "platform",
      "tier": 4,
      "rules": {
        "gh-repo-delete": {
          "severity": "critical",
          "reason": "gh repo delete",
          "match": [{ "commands": ["gh"], "seq": [["repo"], ["delete"]] }]
        },
        "gh-release-delete": {
          "severity": "high",
          "reason": "gh release delete",
          "match": [{ "commands": ["gh"], "seq": [["release"], ["delete", "delete-asset"]] }]
        },
        "gh-secret-delete": {
          "severity": "high",
          "reason": "gh secret or variable delete",
          "match": [
            {
              "commands": ["gh"],
              "seq": [
                ["secret", "variable"],
                ["delete", "remove"]
              ]
            }
          ]
        },
        "gh-api-delete": {
          "severity": "high",
          "reason": "gh api with DELETE",
          "match": [{ "commands": ["gh"], "first": ["api"], "arg": "^(-X|--method)?=?DELETE$" }]
        },
        "gh-workflow-run": {
          "severity": "medium",
          "reason": "gh workflow run starts a CI workflow",
          "match": [{ "commands": ["gh"], "seq": [["workflow"], ["run"]] }]
        },
        "vercel-remove": {
          "severity": "high",
          "reason": "vercel remove",
          "match": [{ "commands": ["vercel"], "first": ["remove", "rm"] }]
        },
        "netlify-delete": {
          "severity": "high",
          "reason": "netlify sites:delete",
          "match": [{ "commands": ["netlify"], "first": ["sites:delete"] }]
        },
        "heroku-destroy": {
          "severity": "critical",
          "reason": "heroku apps:destroy",
          "match": [{ "commands": ["heroku"], "first": ["apps:destroy", "destroy", "pg:reset"] }]
        },
        "fly-destroy": {
          "severity": "critical",
          "reason": "fly apps destroy",
          "match": [{ "commands": ["fly", "flyctl"], "seq": [["apps", "volumes"], ["destroy"]] }]
        }
      }
    }
  ]
}

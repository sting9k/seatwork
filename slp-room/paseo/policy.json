      "code-review",
      "simplify",
      "security-review",
      "review",
      "batch",
      "debug"
    ],
    "$comment_deniedSkills": "Claude Code bundled skills that overlap the room (scheduling, orchestration, config editing, sub-agent reviews). Applied as Skill(skill:<name>) deny rules in the provider's disallowedTools."
  },
  "codex": {
    "runtime": {
      "shareFiles": [
        "auth.json",
        "AGENTS.md",
        "rules",
        "version.json"
      ],
      "shareSkills": [],
      "sharePlugins": false,
      "shareHooks": false,
      "stripTables": [
        "mcp_servers",
        "plugins",
        "hooks"
      ],
      "stripKeys": [
        "notify"
      ],
      "featuresOff": [
        "multi_agent",
        "agent_message_board",
        "browser_use",
        "browser_use_external",
        "browser_use_full_cdp_access",
        "in_app_browser",
        "computer_use",
        "apps",
        "memories"
      ],
      "multiAgentV2Off": true,
      "agentsOff": true
    }
  },
  "pi": {
    "runtime": {
      "$comment": "Pi only receives Paseo tools when the pi-mcp-adapter extension is installed (pi install npm:pi-mcp-adapter). keepPackages lists substrings of user packages to carry into the seat; everything else is dropped.",
      "shareFiles": [
        "auth.json",
        "models.json",
        "models-store.json",
        "AGENTS.md"
      ],
      "shareDirs": [],
      "keepPackages": [
        "pi-mcp-adapter"
      ],
      "settings": {
        "extensions": []
      }
    }
  },
  "opencode": {
    "runtime": {
      "shareEntries": [],
      "config": {
        "$schema": "https://opencode.ai/config.json",
        "permission": {
          "task": "deny"
        },
        "agent": {
          "general": {
            "disable": true
          },
          "explore": {
            "disable": true
          },
          "scout": {
            "disable": true
          }
        }
      }
    }
  },
  "daemon": {
    "$comment": "Daemon-wide switches install.sh applies to ~/.paseo/config.json. These affect every agent on the host, not only seats.",
    "browserTools": false,
    "enableTerminalAgentHooks": false,
    "dictation": false,
    "voiceMode": false,
    "bundledSkills": "none"
  },
  "mail": {
    "$comment": "The room's MCP server (slp_mail, slp_inbox) and delivery rules. Agents never use send_agent_prompt; every message is an envelope the plugin delivers without interrupting anyone.",
    "port": 47611,
    "maxBodyChars": 4000,
    "holdFyiWhileRunning": true,
    "midTurn": {
      "claude": "hold",
      "codex": "hold",
      "pi": "hold",
      "opencode": "hold"
    },
    "$comment_midTurn": "Mail to a RUNNING seat. 'steer' hands it to Paseo's steer; observed on 2026-10-07: Claude cancels the running tool ('[Request interrupted by user for tool use]') and Pi aborts it ('Command aborted'), so every harness is 'hold': mail is delivered the moment the recipient's turn ends. Keep 'hold' unless you verify a harness applies steer after the tool call."
  },
  "gc": {
    "$comment": "Room garbage collection, run by the plugin every everyMinutes and on agent.archived. A seat idle longer than its role's hours (0 = never) is archived unless one of its descendants is still alive; heartbeats whose seat is archived or gone are deleted; mail still held for an archived seat is bounced to its sender. It never kills processes and never touches agents that are not room seats.",
    "everyMinutes": 10,
    "idleHoursBeforeArchive": {
      "hq": 0,
      "supervisor": 168,
      "lead": 48,
      "peer": 48,
      "lens": 12
    },
    "deleteOrphanHeartbeats": true,
    "tellParent": true
  },
  "room": {
    "$comment": "Who may mail whom and who may create whom; the plugin checks both. They guard against mistakes and are not a security boundary: every seat runs as the same user. Nothing travels up from a Supervisor to hq (turn ends, permissions, GC notices, mail): hq looks at the room and sends down. A spawn entry role:spec allows only that specialization (supervisor: peer:research). A mail off the route table or outside the tree is refused; a seat created outside spawn is archived and its parent told (its first prompt may have started by then). params are quoted by the role prompts through {{placeholders}}.",
    "routes": {
      "hq>supervisor": true,
      "supervisor>hq": false,
      "supervisor>lead": true,
      "lead>supervisor": true,
      "lead>peer": true,
      "peer>lead": true,
      "supervisor>peer": true,
      "peer>supervisor": true,
      "hq>lead": false,
      "hq>peer": false,
      "lead>lead": false,
      "peer>peer": false,
      "supervisor>supervisor": false,
      "hq>hq": false,
      "lead>lens": true,
      "lens>lead": true,
      "supervisor>lens": false,
      "lens>supervisor": false,
      "hq>lens": false,
      "peer>lens": false,
      "lens>peer": false,
      "lens>lens": false
    },
    "spawn": {
      "hq": [
        "supervisor"
      ],
      "supervisor": [
        "lead",
        "peer:research"
      ],
      "lead": [
        "peer",
        "lens"
      ],
      "peer": [],
      "lens": []
    },
    "params": {
      "heartbeatCron": "*/15 * * * *",
      "peerStallMinutes": 6,
      "reviewStallMinutes": 30,
      "leadStallMinutes": 30,
      "readBudgetTokens": 80000,
      "cheapReadBudgetTokens": 40000
    }
  }
}

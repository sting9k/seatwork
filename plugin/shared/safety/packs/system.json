{
  "$comment": "Disks, permissions, services. Match fields: see server/safety/gate/packs.ts (Match). A safe block lifts its pack from a command.",
  "packs": [
    {
      "id": "system.disk",
      "tier": 2,
      "default": true,
      "safe": [
        { "commands": ["lsblk", "blkid", "df"] },
        { "commands": ["parted"], "flags": ["-l", "--list"] },
        { "commands": ["diskutil"], "first": ["list", "info", "information", "activity", "listfilesystems"] },
        {
          "commands": ["diskutil"],
          "seq": [
            ["apfs", "ap"],
            ["list", "listsnapshots", "listusers"]
          ]
        },
        { "commands": ["btrfs"], "seq": [["subvolume"], ["list", "show"]] },
        { "commands": ["btrfs"], "seq": [["filesystem"], ["show", "df", "usage"]] },
        { "commands": ["btrfs"], "seq": [["device"], ["stats"]] },
        { "commands": ["btrfs"], "seq": [["property"], ["get", "list"]] },
        { "commands": ["btrfs"], "seq": [["scrub"], ["status"]] },
        { "commands": ["dmsetup"], "first": ["ls", "status", "info", "table", "deps"] }
      ],
      "rules": {
        "tee-device": {
          "severity": "high",
          "reason": "tee writes onto a device",
          "explanation": "Writing a block device overwrites the disk under every file system on it.",
          "safer": ["Write to a file"],
          "match": [
            {
              "commands": ["tee", "sponge"],
              "arg": "^/dev/(?!(null|zero|full|random|urandom|stdin|stdout|stderr|tty|console|ptmx)$|fd/\\d+$|pts/\\d+$|shm/(?!.*\\.\\.))"
            }
          ]
        },
        "copy-to-device": {
          "severity": "high",
          "reason": "cp, mv or install onto a device",
          "explanation": "Copying onto a block device overwrites the disk.",
          "safer": ["Copy to a file"],
          "match": [
            {
              "commands": ["cp", "mv", "install"],
              "last": "^/dev/(?!(null|zero|full|random|urandom|stdout|stderr|tty)$|fd/\\d+$|shm/)"
            }
          ]
        },
        "dd-device": {
          "severity": "high",
          "reason": "dd writes onto a device",
          "explanation": "dd onto a block device overwrites the disk without a question.",
          "safer": ["Check the target with diskutil list first", "dd if=<file> of=/dev/null only reads"],
          "match": [{ "commands": ["dd", "gdd"], "arg": "^of=/dev/(?!(null|zero|full)$)" }]
        },
        "dd-wipe": {
          "severity": "high",
          "reason": "dd fills a device with zeros or random bytes",
          "explanation": "This wipes the disk.",
          "safer": ["Check the target first"],
          "match": [
            { "commands": ["dd", "gdd"], "arg": ["^if=/dev/(zero|u?random)$", "^of=/dev/(?!(null|zero|full)$)"] }
          ]
        },
        "ddrescue-device": {
          "severity": "critical",
          "reason": "ddrescue --force writes onto a device",
          "explanation": "With --force ddrescue overwrites a device.",
          "safer": ["Rescue into an image file"],
          "match": [{ "commands": ["ddrescue"], "flags": ["--force", "short:f"], "arg": "^/dev/" }]
        },
        "sfdisk-modify": {
          "severity": "high",
          "reason": "sfdisk changes a partition table",
          "explanation": "A changed partition table can make every file system on the disk unreadable.",
          "safer": ["sfdisk -l or --dump to read"],
          "match": [
            {
              "commands": ["sfdisk"],
              "arg": "^/dev/",
              "noFlags": [
                "-l",
                "--list",
                "-F",
                "-d",
                "--dump",
                "-J",
                "--json",
                "-s",
                "-g",
                "-V",
                "-n",
                "--no-act",
                "-h",
                "-v"
              ]
            }
          ]
        },
        "fdisk-edit": {
          "severity": "high",
          "reason": "fdisk edits a partition table",
          "explanation": "fdisk is interactive and can rewrite the table.",
          "safer": ["fdisk -l to read"],
          "match": [{ "commands": ["fdisk"], "arg": "^/dev/", "noFlags": ["-l"] }]
        },
        "parted-modify": {
          "severity": "high",
          "reason": "parted changes partitions",
          "explanation": "mklabel, mkpart, rm, resizepart and their kin rewrite the partition table.",
          "safer": ["parted <device> print"],
          "match": [
            {
              "commands": ["parted"],
              "arg": "^(mklabel|mktable|mkpart|rm|resizepart|name|set|toggle|type|rescue|disk_set|disk_toggle)$"
            }
          ]
        },
        "sgdisk-modify": {
          "severity": "high",
          "reason": "sgdisk changes a GPT table",
          "explanation": "Most sgdisk options rewrite the table.",
          "safer": ["sgdisk -p to print", "sgdisk --pretend"],
          "match": [
            {
              "commands": ["sgdisk"],
              "arg": "^/dev/",
              "flags": [
                "short:Z",
                "short:z",
                "short:o",
                "short:d",
                "short:n",
                "short:t",
                "short:c",
                "short:x",
                "short:g",
                "short:G",
                "short:m",
                "short:r",
                "short:s",
                "short:l",
                "short:R",
                "short:U",
                "short:u",
                "short:A",
                "short:e",
                "short:a",
                "short:j",
                "short:N",
                "short:D",
                "short:f",
                "short:C",
                "short:k",
                "short:T"
              ],
              "noFlags": ["-P", "--pretend"]
            }
          ]
        },
        "gdisk-edit": {
          "severity": "high",
          "reason": "gdisk edits a GPT table",
          "explanation": "gdisk is interactive and can rewrite the table.",
          "safer": ["gdisk -l to read"],
          "match": [{ "commands": ["gdisk", "cgdisk"], "arg": "^/dev/", "noFlags": ["-l"] }]
        },
        "mkfs": {
          "severity": "high",
          "reason": "mkfs makes a new file system",
          "explanation": "Formatting erases everything on the target.",
          "safer": ["diskutil list to check the target"],
          "match": [
            {
              "commands": ["mkfs", "mkfs.*", "mke2fs", "mkdosfs", "mkntfs", "mkexfatfs", "newfs", "newfs_*"],
              "minArgs": 1
            }
          ]
        },
        "mkswap": {
          "severity": "high",
          "reason": "mkswap formats a device as swap",
          "explanation": "Even with --check it rewrites the target.",
          "safer": [],
          "match": [{ "commands": ["mkswap"], "minArgs": 1 }]
        },
        "wipefs": {
          "severity": "high",
          "reason": "wipefs erases file system signatures",
          "explanation": "The file systems on the target stop being found.",
          "safer": [],
          "match": [{ "commands": ["wipefs"], "minArgs": 1 }]
        },
        "mount-bind-root": {
          "severity": "high",
          "reason": "mount --bind onto /",
          "explanation": "Binding over the root hides the system under another tree.",
          "safer": [],
          "match": [{ "commands": ["mount"], "flags": ["--bind"], "last": "^/$" }]
        },
        "umount-force": {
          "severity": "high",
          "reason": "umount -f forces a file system off",
          "explanation": "Open files lose their writes.",
          "safer": ["umount without -f"],
          "match": [{ "commands": ["umount"], "flags": ["short:f", "--force"] }]
        },
        "losetup-device": {
          "severity": "high",
          "reason": "losetup attaches a loop device",
          "explanation": "A loop device can map a file over a disk path.",
          "safer": [],
          "match": [{ "commands": ["losetup"], "arg": "^/dev/loop" }]
        },
        "mdadm-stop": {
          "severity": "high",
          "reason": "mdadm --stop stops a RAID array",
          "explanation": "The array's file systems go away at once.",
          "safer": [],
          "match": [{ "commands": ["mdadm"], "flags": ["--stop", "-S"] }]
        },
        "mdadm-remove": {
          "severity": "high",
          "reason": "mdadm --remove takes a disk out of an array",
          "explanation": "The array loses redundancy.",
          "safer": [],
          "match": [{ "commands": ["mdadm"], "flags": ["--remove"] }]
        },
        "mdadm-fail": {
          "severity": "high",
          "reason": "mdadm --fail marks a disk failed",
          "explanation": "The array loses redundancy.",
          "safer": [],
          "match": [{ "commands": ["mdadm"], "flags": ["--fail", "-f"] }]
        },
        "mdadm-zero-superblock": {
          "severity": "high",
          "reason": "mdadm --zero-superblock erases RAID metadata",
          "explanation": "The disk can no longer rejoin its array.",
          "safer": [],
          "match": [{ "commands": ["mdadm"], "flags": ["--zero-superblock"] }]
        },
        "mdadm-create": {
          "severity": "high",
          "reason": "mdadm --create builds an array over disks",
          "explanation": "The data on the member disks is lost.",
          "safer": [],
          "match": [{ "commands": ["mdadm"], "flags": ["--create", "-C"] }]
        },
        "mdadm-grow": {
          "severity": "high",
          "reason": "mdadm --grow reshapes an array",
          "explanation": "A failed reshape can lose the array.",
          "safer": [],
          "match": [{ "commands": ["mdadm"], "flags": ["--grow"] }]
        },
        "btrfs-subvolume-delete": {
          "severity": "high",
          "reason": "btrfs subvolume delete",
          "explanation": "The subvolume and its files are gone.",
          "safer": ["btrfs subvolume list"],
          "match": [{ "commands": ["btrfs"], "seq": [["subvolume"], ["delete"]] }]
        },
        "btrfs-device-remove": {
          "severity": "high",
          "reason": "btrfs device remove",
          "explanation": "Data moves off the disk; a failure mid-way risks it.",
          "safer": [],
          "match": [{ "commands": ["btrfs"], "seq": [["device"], ["remove", "delete"]] }]
        },
        "btrfs-device-add": {
          "severity": "high",
          "reason": "btrfs device add",
          "explanation": "The added disk's content is overwritten.",
          "safer": [],
          "match": [{ "commands": ["btrfs"], "seq": [["device"], ["add"]] }]
        },
        "btrfs-balance": {
          "severity": "high",
          "reason": "btrfs balance start",
          "explanation": "A balance rewrites the whole file system.",
          "safer": [],
          "match": [{ "commands": ["btrfs"], "seq": [["balance"], ["start"]] }]
        },
        "btrfs-check-repair": {
          "severity": "high",
          "reason": "btrfs check --repair",
          "explanation": "Repair can make a damaged file system worse.",
          "safer": ["btrfs check without --repair"],
          "match": [{ "commands": ["btrfs"], "seq": [["check"]], "flags": ["--repair"] }]
        },
        "btrfs-rescue": {
          "severity": "high",
          "reason": "btrfs rescue",
          "explanation": "Rescue commands rewrite metadata.",
          "safer": [],
          "match": [{ "commands": ["btrfs"], "seq": [["rescue"]] }]
        },
        "btrfs-filesystem-resize": {
          "severity": "high",
          "reason": "btrfs filesystem resize",
          "explanation": "Shrinking can lose data.",
          "safer": [],
          "match": [{ "commands": ["btrfs"], "seq": [["filesystem"], ["resize"]] }]
        },
        "dmsetup-remove": {
          "severity": "high",
          "reason": "dmsetup remove",
          "explanation": "The mapped device goes away under its users.",
          "safer": ["dmsetup ls"],
          "match": [{ "commands": ["dmsetup"], "first": ["remove"] }]
        },
        "dmsetup-remove-all": {
          "severity": "high",
          "reason": "dmsetup remove_all",
          "explanation": "Every mapped device goes away.",
          "safer": [],
          "match": [{ "commands": ["dmsetup"], "first": ["remove_all"] }]
        },
        "dmsetup-wipe-table": {
          "severity": "high",
          "reason": "dmsetup wipe_table",
          "explanation": "The device's mapping is replaced by errors.",
          "safer": [],
          "match": [{ "commands": ["dmsetup"], "first": ["wipe_table"] }]
        },
        "dmsetup-clear": {
          "severity": "high",
          "reason": "dmsetup clear",
          "explanation": "The inactive table is dropped.",
          "safer": [],
          "match": [{ "commands": ["dmsetup"], "first": ["clear"] }]
        },
        "dmsetup-load": {
          "severity": "high",
          "reason": "dmsetup load",
          "explanation": "A new table can point the device anywhere.",
          "safer": [],
          "match": [{ "commands": ["dmsetup"], "first": ["load"] }]
        },
        "dmsetup-create": {
          "severity": "high",
          "reason": "dmsetup create",
          "explanation": "A new mapping can overlay a live disk.",
          "safer": [],
          "match": [{ "commands": ["dmsetup"], "first": ["create"] }]
        },
        "nbd-client-disconnect": {
          "severity": "high",
          "reason": "nbd-client -d disconnects a network disk",
          "explanation": "Its file systems lose their device.",
          "safer": [],
          "match": [{ "commands": ["nbd-client"], "flags": ["-d"] }]
        },
        "nbd-client-connect": {
          "severity": "high",
          "reason": "nbd-client connects a network disk onto a device",
          "explanation": "The device is replaced by the remote disk.",
          "safer": [],
          "match": [{ "commands": ["nbd-client"], "arg": "^/dev/nbd" }]
        },
        "pvremove": {
          "severity": "high",
          "reason": "pvremove",
          "explanation": "LVM metadata is wiped from the disk.",
          "safer": [],
          "match": [{ "commands": ["pvremove"] }]
        },
        "vgremove": {
          "severity": "high",
          "reason": "vgremove",
          "explanation": "The volume group and its volumes go.",
          "safer": [],
          "match": [{ "commands": ["vgremove"] }]
        },
        "lvremove": {
          "severity": "high",
          "reason": "lvremove",
          "explanation": "The logical volume and its data go.",
          "safer": [],
          "match": [{ "commands": ["lvremove"] }]
        },
        "vgreduce": {
          "severity": "high",
          "reason": "vgreduce",
          "explanation": "A disk leaves the volume group.",
          "safer": [],
          "match": [{ "commands": ["vgreduce"] }]
        },
        "lvreduce": {
          "severity": "high",
          "reason": "lvreduce",
          "explanation": "Shrinking a volume below its file system loses data.",
          "safer": [],
          "match": [{ "commands": ["lvreduce"] }]
        },
        "lvresize-shrink": {
          "severity": "high",
          "reason": "lvresize shrinks a volume",
          "explanation": "Shrinking a volume below its file system loses data.",
          "safer": [],
          "match": [{ "commands": ["lvresize"], "arg": "^(-[Ll]-|--size=-|-[Ll]$)" }]
        },
        "pvmove": {
          "severity": "high",
          "reason": "pvmove",
          "explanation": "Moving extents live risks the data on failure.",
          "safer": [],
          "match": [{ "commands": ["pvmove"] }]
        },
        "lvconvert-merge": {
          "severity": "high",
          "reason": "lvconvert --merge",
          "explanation": "Merging a snapshot rolls the volume back.",
          "safer": [],
          "match": [{ "commands": ["lvconvert"], "flags": ["--merge"] }]
        },
        "diskutil-erase": {
          "severity": "critical",
          "reason": "diskutil erases a disk or volume",
          "explanation": "eraseDisk, eraseVolume, reformat and the zero/random/secure erases wipe the target.",
          "safer": ["diskutil list", "diskutil info <disk>"],
          "match": [
            {
              "commands": ["diskutil"],
              "first": ["erasedisk", "erasevolume", "reformat", "zerodisk", "randomdisk", "secureerase"]
            }
          ]
        },
        "diskutil-partition": {
          "severity": "critical",
          "reason": "diskutil repartitions a disk",
          "explanation": "Repartitioning can erase the disk's volumes.",
          "safer": ["diskutil list"],
          "match": [
            { "commands": ["diskutil"], "first": ["partitiondisk", "splitpartition", "mergepartitions", "resetfusion"] }
          ]
        },
        "diskutil-apfs-delete": {
          "severity": "critical",
          "reason": "diskutil apfs deletes a container, volume or snapshot",
          "explanation": "The APFS object and its data go.",
          "safer": ["diskutil apfs list"],
          "match": [
            {
              "commands": ["diskutil"],
              "seq": [
                ["apfs", "ap"],
                ["deletecontainer", "deletevolume", "erasevolume", "deletesnapshot"]
              ]
            }
          ]
        },
        "blkdiscard": {
          "severity": "critical",
          "reason": "blkdiscard discards every block of a device",
          "explanation": "On an SSD the data is gone at once.",
          "safer": [],
          "match": [{ "commands": ["blkdiscard"] }]
        },
        "cryptsetup-erase": {
          "severity": "critical",
          "reason": "cryptsetup erases or formats an encrypted volume",
          "explanation": "Without its key slots the volume can never be opened.",
          "safer": ["cryptsetup status"],
          "match": [
            {
              "commands": ["cryptsetup"],
              "first": ["luksErase", "luksFormat", "erase", "luksKillSlot", "lukserase", "luksformat", "lukskillslot"]
            }
          ]
        },
        "hdparm-security-erase": {
          "severity": "critical",
          "reason": "hdparm --security-erase",
          "explanation": "The drive erases itself.",
          "safer": ["hdparm -I"],
          "match": [{ "commands": ["hdparm"], "flags": ["--security-erase", "--security-erase-enhanced"] }]
        },
        "nvme-format-sanitize": {
          "severity": "critical",
          "reason": "nvme format or sanitize",
          "explanation": "The drive's data is erased.",
          "safer": ["nvme list"],
          "match": [{ "commands": ["nvme"], "first": ["format", "sanitize"] }]
        },
        "badblocks-write": {
          "severity": "critical",
          "reason": "badblocks -w writes test patterns over a device",
          "explanation": "The write test destroys the data.",
          "safer": ["badblocks without -w reads only"],
          "match": [{ "commands": ["badblocks"], "flags": ["short:w"] }]
        },
        "sg_format": {
          "severity": "critical",
          "reason": "sg_format --format",
          "explanation": "A low-level format erases the drive.",
          "safer": [],
          "match": [{ "commands": ["sg_format"], "flags": ["--format"] }]
        },
        "zpool-destroy": {
          "severity": "critical",
          "reason": "zpool destroy",
          "explanation": "The pool and every dataset in it go.",
          "safer": ["zpool status"],
          "match": [{ "commands": ["zpool"], "first": ["destroy"] }]
        },
        "zfs-destroy": {
          "severity": "critical",
          "reason": "zfs destroy",
          "explanation": "The dataset and its snapshots go.",
          "safer": ["zfs list"],
          "match": [{ "commands": ["zfs"], "first": ["destroy"] }]
        },
        "nwipe": {
          "severity": "critical",
          "reason": "nwipe wipes disks",
          "explanation": "The disks are overwritten.",
          "safer": [],
          "match": [{ "commands": ["nwipe"] }]
        },
        "scrub-device": {
          "severity": "critical",
          "reason": "scrub overwrites a device",
          "explanation": "scrub destroys the device's data.",
          "safer": [],
          "match": [{ "commands": ["scrub"], "arg": "^/dev/" }]
        },
        "wipe-device": {
          "severity": "critical",
          "reason": "wipe overwrites a device",
          "explanation": "wipe destroys the device's data.",
          "safer": [],
          "match": [{ "commands": ["wipe"], "arg": "^/dev/" }]
        }
      }
    },
    {
      "id": "system.permissions",
      "tier": 2,
      "safe": [{ "commands": ["stat", "getfacl", "namei"] }],
      "rules": {
        "chmod-777": {
          "severity": "high",
          "reason": "chmod 777 lets every user write the file",
          "explanation": "World-writable files can be changed by anyone on the machine.",
          "safer": ["chmod 755 for programs", "chmod 644 for files"],
          "match": [{ "commands": ["chmod"], "arg": "^(=?0?777)$" }]
        },
        "chmod-recursive-root": {
          "severity": "critical",
          "reason": "chmod -R on the system or a whole home",
          "explanation": "Changing modes across these trees breaks programs and exposes private files.",
          "safer": ["chmod a subfolder of your project"],
          "match": [
            {
              "commands": ["chmod"],
              "flags": ["short:R", "--recursive"],
              "arg": "^(/|/(bin|boot|dev|etc|lib|lib64|opt|proc|root|run|sbin|srv|sys|usr|var|System|Library)(/.*)?|/(home|Users)(/[^/]+)?/?|~/?|\\$HOME/?)$"
            }
          ]
        },
        "chown-recursive-root": {
          "severity": "high",
          "reason": "chown -R on the system or a whole home",
          "explanation": "Changing owners across these trees breaks programs and logins.",
          "safer": ["chown a subfolder of your project"],
          "match": [
            {
              "commands": ["chown"],
              "flags": ["short:R", "--recursive"],
              "arg": "^(/|/(bin|boot|dev|etc|lib|lib64|opt|proc|root|run|sbin|srv|sys|usr|var|System|Library)(/.*)?|/(home|Users)(/[^/]+)?/?|~/?|\\$HOME/?)$"
            }
          ]
        },
        "chgrp-recursive-root": {
          "severity": "high",
          "reason": "chgrp -R on the system or a whole home",
          "explanation": "Changing groups across these trees breaks access.",
          "safer": [],
          "match": [
            {
              "commands": ["chgrp"],
              "flags": ["short:R", "--recursive"],
              "arg": "^(/|/(bin|boot|dev|etc|lib|lib64|opt|proc|root|run|sbin|srv|sys|usr|var|System|Library)(/.*)?|/(home|Users)(/[^/]+)?/?|~/?|\\$HOME/?)$"
            }
          ]
        },
        "chmod-setuid": {
          "severity": "high",
          "reason": "chmod sets the setuid bit",
          "explanation": "A setuid program runs as its owner, often root.",
          "safer": [],
          "match": [{ "commands": ["chmod"], "arg": "^(u\\+s|[ugoa]*\\+[rwx]*s[rwx]*|[4-7][0-7]{3})$" }]
        },
        "chmod-setgid": {
          "severity": "high",
          "reason": "chmod sets the setgid bit",
          "explanation": "A setgid program runs with its group's rights.",
          "safer": [],
          "match": [{ "commands": ["chmod"], "arg": "^(g\\+s|[2367][0-7]{3})$" }]
        },
        "chown-to-root": {
          "severity": "high",
          "reason": "chown to root",
          "explanation": "Files owned by root can lock the user out of their own work.",
          "safer": [],
          "match": [{ "commands": ["chown"], "arg": "^root(:.*)?$" }]
        },
        "setfacl-all": {
          "severity": "critical",
          "reason": "setfacl -R on the system or a whole home",
          "explanation": "ACLs across these trees change who can read and write everything.",
          "safer": [],
          "match": [
            {
              "commands": ["setfacl"],
              "flags": ["short:R", "--recursive"],
              "arg": "^(/|/(bin|boot|dev|etc|lib|lib64|opt|proc|root|run|sbin|srv|sys|usr|var)(/.*)?|/(home|Users)(/[^/]+)?/?|~/?)$"
            }
          ]
        }
      }
    },
    {
      "id": "system.services",
      "tier": 2,
      "safe": [
        {
          "commands": ["systemctl"],
          "first": [
            "status",
            "list-units",
            "list-unit-files",
            "list-sockets",
            "list-timers",
            "show",
            "is-active",
            "is-enabled",
            "is-failed",
            "daemon-reload",
            "cat"
          ]
        },
        { "commands": ["journalctl"] }
      ],
      "rules": {
        "systemctl-stop-critical": {
          "severity": "high",
          "reason": "systemctl stops a service the machine needs for access",
          "explanation": "Stopping ssh, the network, the firewall or docker can cut the machine off.",
          "safer": ["systemctl restart"],
          "match": [
            {
              "commands": ["systemctl"],
              "first": ["stop", "disable", "mask"],
              "arg": "^(ssh|sshd|network|networking|firewalld|ufw|docker|containerd)(\\.service)?$"
            }
          ]
        },
        "systemctl-stop": {
          "severity": "high",
          "reason": "systemctl stops, disables or masks a service",
          "explanation": "Whatever depends on the service stops working.",
          "safer": ["systemctl restart", "systemctl status"],
          "match": [{ "commands": ["systemctl"], "first": ["stop", "disable", "mask"] }]
        },
        "service-stop-critical": {
          "severity": "high",
          "reason": "service stops ssh, the network or docker",
          "explanation": "This can cut the machine off.",
          "safer": [],
          "match": [{ "commands": ["service"], "seq": [["ssh", "sshd", "network", "networking", "docker"], ["stop"]] }]
        },
        "systemctl-isolate": {
          "severity": "high",
          "reason": "systemctl isolate switches the system's target",
          "explanation": "Every service outside the target stops.",
          "safer": [],
          "match": [{ "commands": ["systemctl"], "first": ["isolate"] }]
        },
        "systemctl-power": {
          "severity": "critical",
          "reason": "systemctl powers off, reboots or suspends the machine",
          "explanation": "Every running seat and job stops.",
          "safer": [],
          "match": [{ "commands": ["systemctl"], "first": ["poweroff", "reboot", "halt", "suspend", "hibernate"] }]
        },
        "shutdown": {
          "severity": "critical",
          "reason": "shutdown",
          "explanation": "Every running seat and job stops.",
          "safer": [],
          "match": [{ "commands": ["shutdown", "halt", "poweroff"] }]
        },
        "reboot": {
          "severity": "critical",
          "reason": "reboot",
          "explanation": "Every running seat and job stops.",
          "safer": [],
          "match": [{ "commands": ["reboot"] }]
        },
        "init-level": {
          "severity": "critical",
          "reason": "init 0 or init 6",
          "explanation": "This halts or reboots the machine.",
          "safer": [],
          "match": [{ "commands": ["init", "telinit"], "first": ["0", "6"] }]
        },
        "launchctl-unload": {
          "severity": "high",
          "reason": "launchctl removes or stops a launch service",
          "explanation": "On macOS this stops agents and daemons the user relies on.",
          "safer": ["launchctl list"],
          "match": [{ "commands": ["launchctl"], "first": ["unload", "bootout", "remove", "disable", "kill"] }]
        }
      }
    }
  ]
}

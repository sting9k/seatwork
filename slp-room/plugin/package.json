{
  "name": "slp-seat",
  "private": true,
  "version": "0.12.0",
  "description": "Paseo plugin: isolated per-seat runtimes and role prompts for a Supervisor → Lead → Peer room across Claude, Codex, Pi and OpenCode.",
  "files": [
    "paseo-plugin.json",
    "index.server.ts",
    "index.client.ts",
    "server/",
    "client/",
    "shared/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --require ./test/register.cjs --test \"test/*.test.ts\"",
    "watch:replay": "node --require ./test/register.cjs tools/watch-replay.ts"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.11.2",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}

  "claude": {
    "$comment": "disallowedTools uses Claude Code's permission syntax. Agent/Task/ListAgents/SendMessage are Claude's own sub-agent and messaging tools; ScheduleWakeup/Cron*/Workflow are its own scheduling and orchestration; the Bash rules stop a seat from starting a nested harness or driving Paseo from the shell.",
    "disallowedTools": {
      "hq": [
        "Agent",
        "Task",
        "Bash(claude:*)",
        "Bash(codex:*)",
        "Bash(pi:*)",
        "Bash(opencode:*)",
        "Bash(paseo run:*)",
        "Bash(paseo send:*)",
        "Bash(paseo import:*)",
        "Bash(paseo agent:*)",
        "Bash(paseo schedule:*)",
        "ScheduleWakeup",
        "CronCreate",
        "CronDelete",
        "CronList",
        "Workflow",
        "SendMessage",
        "ListAgents"
      ],
      "supervisor": [
        "Agent",
        "Task",
        "Bash(claude:*)",
        "Bash(codex:*)",
        "Bash(pi:*)",
        "Bash(opencode:*)",
        "Bash(paseo run:*)",
        "Bash(paseo send:*)",
        "Bash(paseo import:*)",
        "Bash(paseo agent:*)",
        "Bash(paseo schedule:*)",
        "ScheduleWakeup",
        "CronCreate",
        "CronDelete",
        "CronList",
        "Workflow",
        "SendMessage",
        "ListAgents"
      ],
      "lead": [

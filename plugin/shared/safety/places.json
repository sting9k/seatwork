{
  "$comment": "Where a file lies, for the guard's records. Paths under home are relative to it and compare without case; one ending in / is a folder. startup: what runs later by itself, or names a program that does; credentials: the owner's keys and tokens; open: names under those that hold no key and run nothing, by pattern; gitRuns: patterns of the paths inside a .git folder that git reads programs from; roomFolderOpen: the files of the room's folder in a project that seats keep; envRoots: the folder under home a variable names; system: the machine's own folders. secrets: the daemon's files in its home (paseoHome) and the room's key folders (roomHome), which no seat reads: with them a program is the daemon's owner or spends the room's keys; named: their names, which stand for them wherever they are spelled.",
  "startup": [
    ".bashrc",
    ".bash_profile",
    ".bash_login",
    ".bash_logout",
    ".profile",
    ".zshrc",
    ".zshenv",
    ".zprofile",
    ".zlogin",
    ".zlogout",
    ".bashrc.d/",
    ".zshrc.d/",
    ".config/fish/",
    ".gitconfig",
    ".config/git/config",
    ".ssh/config",
    ".aws/config",
    "library/launchagents/"
  ],
  "credentials": [
    ".ssh/",
    ".gnupg/",
    ".aws/",
    ".azure/",
    ".kube/",
    ".config/gcloud/",
    ".config/gh/hosts.yml",
    ".docker/config.json",
    ".netrc",
    ".git-credentials",
    ".npmrc",
    ".pypirc",
    ".cargo/credentials",
    ".cargo/credentials.toml",
    ".gem/credentials",
    ".vault-token",
    ".terraform.d/credentials.tfrc.json",
    ".password-store/",
    ".pgpass",
    ".my.cnf",
    "library/keychains/"
  ],
  "open": [".ssh/known_hosts", ".ssh/known_hosts2", ".ssh/*.pub"],
  "gitRuns": [
    "^$",
    "^config(\\.worktree)?$",
    "^hooks(/|$)",
    "^info/attributes$",
    "^(modules|worktrees)/.+/(config(\\.worktree)?|hooks(/.*)?|info/attributes)$"
  ],
  "roomFolderOpen": ["status.md"],
  "envRoots": {
    "GNUPGHOME": ".gnupg",
    "XDG_CONFIG_HOME": ".config",
    "GH_CONFIG_DIR": ".config/gh",
    "DOCKER_CONFIG": ".docker",
    "KUBECONFIG": ".kube/config",
    "AWS_SHARED_CREDENTIALS_FILE": ".aws/credentials",
    "AWS_CONFIG_FILE": ".aws/config",
    "NPM_CONFIG_USERCONFIG": ".npmrc",
    "ZDOTDIR": ""
  },
  "system": [
    "/System",
    "/Library",
    "/Applications",
    "/usr",
    "/bin",
    "/sbin",
    "/etc",
    "/var",
    "/private",
    "/opt",
    "/cores",
    "/boot",
    "/lib",
    "/lib64",
    "/root",
    "/srv",
    "/snap",
    "/nix"
  ],
  "secrets": {
    "paseoHome": ["local-credential", "config.json", "daemon-keypair.json", "cli-client-id", "server-id"],
    "roomHome": ["jev"],
    "named": ["local-credential", "daemon-keypair.json"]
  }
}

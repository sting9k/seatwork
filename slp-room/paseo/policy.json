    "shareFiles": [
      "CLAUDE.md"
    ],
    "$comment_shareFiles": "Claude seats run on ~/.claude with personal settings off; these files of it are appended to the seat's prompt.",
    "deniedSkills": [
      "loop",
      "schedule",
      "workflow-authoring",
      "plugin-authoring",
      "update-config",
      "keybindings-help",
      "fewer-permission-prompts",

{
  "$comment": "The room's packs: its own files and the agents' settings, git's config, the daemon, secrets, and software installs.",
  "packs": [
    {
      "id": "room.guard",
      "tier": 0,
      "always": true,
      "rules": {
        "room-file-write": {
          "severity": "critical",
          "reason": "a write into the room's own files or an agent's settings"
        },
        "git-global-config": {
          "severity": "critical",
          "reason": "git config --global or --system changes git for every repository",
          "match": [
            {
              "commands": ["git"],
              "flags": ["--global", "--system"],
              "seq": [["config"]],
              "noFlags": [
                "--get",
                "--get-all",
                "--get-regexp",
                "--list",
                "-l",
                "--show-origin",
                "--show-scope",
                "--get-urlmatch",
                "--name-only"
              ],
              "noArg": "^(get|list)$"
            }
          ]
        },
        "guard-off": {
          "severity": "critical",
          "reason": "an attempt to turn off or route around the room's command guard",
          "match": [
            {
              "commands": ["claude", "cursor-agent", "gemini", "qwen", "droid"],
              "flags": ["-p", "--print", "--prompt"]
            },
            { "commands": ["codex"], "first": ["exec", "e"] },
            { "commands": ["pi"], "flags": ["-p", "--print"] },
            { "commands": ["opencode", "crush", "goose", "amp"], "first": ["run"] },
            { "commands": ["aider"], "flags": ["-m", "--message", "--message-file"] }
          ]
        },
        "git-config-write": {
          "severity": "critical",
          "reason": "a write into .git where git reads programs from: config, hooks or attributes"
        },
        "git-config-exec": {
          "severity": "critical",
          "reason": "git config names a program git runs later: a filter, a text conversion, an external diff, a hook path"
        },
        "git-no-verify": {
          "severity": "high",
          "reason": "git told to skip the repository's hooks"
        },
        "git-attributes-driver": {
          "severity": "critical",
          "reason": "a .gitattributes line that names a filter or driver of the repository's own"
        },
        "paseo-cli": {
          "severity": "critical",
          "reason": "a seat reaching other agents or the daemon through the Paseo CLI"
        },
        "paseo-daemon": {
          "severity": "critical",
          "reason": "a seat reaching the Paseo daemon by its address or its client library"
        },
        "secret-read": {
          "severity": "critical",
          "reason": "a seat reading a key the daemon or the room holds"
        }
      }
    },
    {
      "id": "room.software",
      "tier": 0,
      "default": true,
      "rules": {
        "brew-install": {
          "severity": "high",
          "reason": "brew puts software on the machine",
          "match": [
            {
              "commands": ["brew"],
              "first": ["install", "reinstall", "upgrade", "tap", "bundle", "link", "pin", "unpin", "migrate"]
            }
          ]
        },
        "global-package": {
          "severity": "high",
          "reason": "a global package install changes the machine, not the project",
          "match": [
            {
              "commands": ["npm"],
              "first": [
                "install",
                "i",
                "add",
                "isntall",
                "in",
                "ins",
                "inst",
                "insta",
                "instal",
                "update",
                "up",
                "upgrade",
                "link",
                "ln"
              ],
              "flags": ["-g", "--global", "--location=global"]
            },
            {
              "commands": ["pnpm"],
              "first": ["add", "install", "i", "update", "up", "link"],
              "flags": ["-g", "--global"]
            },
            { "commands": ["yarn"], "seq": [["global"], ["add", "upgrade"]] },
            { "commands": ["bun"], "first": ["add", "install", "i", "update", "link"], "flags": ["-g", "--global"] }
          ]
        },
        "tool-install": {
          "severity": "high",
          "reason": "a tool installer puts programs on the machine",
          "match": [
            {
              "commands": ["pipx"],
              "first": ["install", "upgrade", "upgrade-all", "reinstall", "reinstall-all", "inject", "ensurepath"]
            },
            { "commands": ["uv"], "seq": [["tool"], ["install", "upgrade", "update-shell"]] },
            { "commands": ["uv"], "seq": [["python"], ["install"]] },
            { "commands": ["cargo"], "first": ["install", "binstall"] },
            { "commands": ["go"], "first": ["install"] },
            { "commands": ["gem"], "first": ["install", "update"] },
            {
              "commands": ["pip", "pip3", "pip3.*"],
              "first": ["install"],
              "flags": ["--user", "--break-system-packages", "--system", "--target", "-t", "--prefix", "--root"]
            },
            {
              "commands": ["python", "python3", "python3.*"],
              "seq": [["-m"], ["pip"], ["install"]],
              "flags": ["--user", "--break-system-packages", "--system", "--target", "--prefix", "--root"]
            },
            { "commands": ["corepack"], "first": ["enable", "install", "prepare"] }
          ]
        },
        "runtime-install": {
          "severity": "high",
          "reason": "a version manager downloads a runtime or toolchain",
          "match": [
            {
              "commands": ["nvm", "fnm", "volta", "pyenv", "rbenv", "nodenv", "goenv", "asdf", "sdk", "jenv"],
              "first": ["install", "use"]
            },
            { "commands": ["rustup"], "first": ["install", "update", "default"] },
            {
              "commands": ["rustup"],
              "seq": [
                ["toolchain", "target", "component"],
                ["install", "add"]
              ]
            },
            { "commands": ["mise", "rtx"], "first": ["install", "use", "upgrade", "i", "u"] },
            { "commands": ["n"], "arg": "^(latest|lts|current|stable|\\d+(\\.\\d+)*)$" }
          ]
        },
        "browser-install": {
          "severity": "high",
          "reason": "a test tool downloads browsers",
          "match": [
            { "commands": ["playwright", "playwright-core"], "first": ["install", "install-deps"] },
            { "commands": ["puppeteer"], "seq": [["browsers"], ["install"]] },
            { "commands": ["browsers"], "first": ["install"] },
            { "commands": ["cypress"], "first": ["install"] }
          ]
        },
        "system-package": {
          "severity": "high",
          "reason": "a system package manager installs software",
          "match": [
            {
              "commands": ["apt", "apt-get", "yum", "dnf", "zypper", "apk", "port"],
              "first": [
                "install",
                "reinstall",
                "upgrade",
                "dist-upgrade",
                "full-upgrade",
                "add",
                "update",
                "selfupdate"
              ]
            },
            { "commands": ["pacman"], "flags": ["short:S", "short:U"] },
            { "commands": ["mas"], "first": ["install", "upgrade", "purchase"] },
            { "commands": ["softwareupdate"], "flags": ["-i", "--install", "-a", "--all"] },
            { "commands": ["installer"], "flags": ["-pkg"] }
          ]
        },
        "download-and-run": {
          "severity": "critical",
          "reason": "a download piped straight into a shell or interpreter"
        }
      }
    }
  ]
}
